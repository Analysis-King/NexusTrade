# ─────────────────────────────────────────────────────────────
#  NexusTrade — Environment Configuration
#  Bu dosyayı .env olarak kopyalayın. .env'i ASLA commit etmeyin.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Logging
LOG_LEVEL=debug

# Security
# Bu secret'ı `openssl rand -hex 32` ile üretin. Üretimde DEĞİŞTİRMEK ZORUNLU.
SESSION_SECRET=8910faed6865dc0e8cad8457248f51f29ee71c7200b28d9fd832a4b204ebdbf7
# API key encryption master key (üretimde değiştirin)
ENCRYPTION_KEY=486dbab78593951065ffa1582bf0da980ab7dc452f47bdd9851c2f47f51a6e8f

# CORS — virgülle ayırarak birden fazla origin
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Binance
BINANCE_REST_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443
BINANCE_RECV_WINDOW=5000

# Storage (Hafta 1: dosya tabanlı, Hafta 5'te SQLite)
DATA_DIR=./data

# Python worker
PYTHON_BIN=python3
WORKER_POOL_SIZE=4
# Backtest / cizim / kod dogrulama icin ayri havuz (bot tick'lerini bloklamaz)
JOB_WORKER_POOL_SIZE=2
WORKER_TIMEOUT_MS=10000
