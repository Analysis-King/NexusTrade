# ─────────────────────────────────────────────────────────────
#  NexusTrade — Environment Configuration
#  Bu dosyayı .env olarak kopyalayın. .env'i ASLA commit etmeyin.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Logging
LOG_LEVEL=debug

# Security
# İkisini de `openssl rand -hex 32` ile üretip doldurun; boş bırakılırsa uygulama başlamaz.
# Buraya gerçek değer yazmayın: bu dosya git'e gider.
SESSION_SECRET=
# API key encryption master key
ENCRYPTION_KEY=

# CORS — virgülle ayırarak birden fazla origin
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Rate limiting (pencere basina, IP basina)
# Okuma (GET) ve islem (POST/PATCH/DELETE) istekleri ayri sayilir; arayuzun
# arka plan yoklamalari dolsa bile durdur/sil gibi tiklamalar reddedilmez.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_WRITE_MAX=120

# Binance
BINANCE_REST_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443
BINANCE_RECV_WINDOW=5000

# Storage (Hafta 1: dosya tabanlı, Hafta 5'te SQLite)
DATA_DIR=./data

# Python worker
PYTHON_BIN=python3
WORKER_POOL_SIZE=4
# Backtest / cizim / kod dogrulama icin ayri havuz (bot tick'lerini bloklamaz)
JOB_WORKER_POOL_SIZE=2
WORKER_TIMEOUT_MS=10000
