{
  "name": "nexustrade",
  "version": "2.1.0",
  "description": "NexusTrade — Binance Trading Platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.{ts,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "paper:forward:provision": "node scripts/paper_forward_manager.cjs --action=provision --start=true",
    "paper:forward:report": "node scripts/paper_forward_manager.cjs --action=report",
    "paper:replay": "node scripts/paper_candidate_replay.cjs",
    "paper:harmonic": "node scripts/harmonic_portfolio_paper.cjs --action=start",
    "paper:harmonic:once": "node scripts/harmonic_portfolio_paper.cjs --action=once",
    "paper:harmonic:report": "node scripts/harmonic_portfolio_paper.cjs --action=report",
    "paper:portfolios": "node scripts/start-paper-portfolios.cjs",
    "paper:harmonic:quality": "node scripts/start-harmonic-quality-paper.cjs",
    "paper:harmonic:4x": "node scripts/harmonic_portfolio_paper.cjs --action=start --days=15 --name=Harmonik_QualityTarget_4x --leverage=4 --positions=2 --score=quality_target --state=data/harmonic_quality_target_4x_paper_state.json --report=data/harmonic_quality_target_4x_paper_report.json",
    "paper:harmonic:10x": "node scripts/harmonic_portfolio_paper.cjs --action=start --days=15 --name=Harmonik_QualityTarget_10x --leverage=10 --positions=2 --score=quality_target --state=data/harmonic_quality_target_10x_paper_state.json --report=data/harmonic_quality_target_10x_paper_report.json",
    "paper:scanner:v2": "node scripts/harmonic_scanner_paper_v2.cjs --action=start",
    "paper:scanner:v2:once": "node scripts/harmonic_scanner_paper_v2.cjs --action=once",
    "paper:scanner:v2:report": "node scripts/harmonic_scanner_paper_v2.cjs --action=report",
    "paper:scanner:htf": "node scripts/harmonic_scanner_htf_confirm_paper.cjs --action=start",
    "paper:scanner:htf:once": "node scripts/harmonic_scanner_htf_confirm_paper.cjs --action=once",
    "paper:scanner:htf:report": "node scripts/harmonic_scanner_htf_confirm_paper.cjs --action=report"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
